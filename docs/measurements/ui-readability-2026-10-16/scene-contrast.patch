--- a/src/cumulonimbus/scene.css
+++ b/src/cumulonimbus/scene.css
@@ -5,12 +5,14 @@
 .cloud-stage canvas{display:block;width:100%;height:100%;object-fit:contain;cursor:grab;touch-action:none}
 .cloud-stage canvas.dragging{cursor:grabbing}
 .cloud-stage canvas:focus-visible{outline:2px solid var(--accent);outline-offset:-4px}
-.scene-heading{position:absolute;top:max(28px,env(safe-area-inset-top));left:max(32px,env(safe-area-inset-left));pointer-events:none;text-shadow:0 2px 24px #142b3b40}
+.scene-heading{position:absolute;top:max(28px,env(safe-area-inset-top));left:max(32px,env(safe-area-inset-left));pointer-events:none;isolation:isolate}
+.scene-heading::before{content:"";position:absolute;inset:-10px -12px;z-index:-1;background:#202a2deb;border-radius:10px}
 .scene-heading h1{font-family:Georgia,serif;font-weight:400;font-size:56px;line-height:1;letter-spacing:-.065em;margin:0 0 9px}
 .brand-dot{color:var(--selected)}
 .scene-heading p{font-size:12px;margin:0;display:flex;align-items:center;gap:8px}
 .live-dot{width:3px;height:3px;background:currentColor;border-radius:50%;opacity:.7}
-.view-help{position:absolute;left:24px;bottom:14px;margin:0;font-size:10px;color:var(--ink);pointer-events:none;text-shadow:0 1px 6px #0006}
+.view-help{position:absolute;left:24px;bottom:14px;margin:0;font-size:10px;color:var(--ink);pointer-events:none;isolation:isolate}
+.view-help::before{content:"";position:absolute;inset:-5px -8px;z-index:-1;background:#202a2deb;border-radius:6px}
 .scene-loading{position:absolute;top:48%;left:50%;transform:translateX(-50%);font-size:14px;background:var(--panel);padding:15px 22px;max-width:85%;border-radius:12px}
 .scene-loading.loaded{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
 .scene-loading.failed{width:min(540px,85%);padding:24px;background:#f2e7db;color:#342a26;z-index:5}
