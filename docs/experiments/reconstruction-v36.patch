+import {DataUtils} from 'three/webgpu';
+
+/** RG16F: dimensionless signed condensation coordinate U before clamp, followed
+ * by original material modulation M. U already includes the voxel's ice gain
+ * and offset; it is neither a signed distance nor measured in kilometres.
+ */
+export interface ReconstructionVolume {size:number;data:Uint16Array}
+export const RECONSTRUCTION_EMPTY_U=-32;
+export const reconstructedDensity=(u:number,modulation:number)=>Math.max(0,Math.min(1,u))*modulation;
+
+/** Match normalized linear/clamp RG16F texture sampling, including half texels.
+ * Decode each vertex before interpolation. With no channel, reconstruct density
+ * from both interpolated channels in one eight-vertex traversal.
+ */
+function interpolate(volume:ReconstructionVolume,x:number,y:number,z:number,channel?:0|1):number {
+  const {size,data}=volume;
+  const px=Math.max(0,Math.min(1,x))*size-.5,py=Math.max(0,Math.min(1,y))*size-.5,pz=Math.max(0,Math.min(1,z))*size-.5;
+  const ix=Math.floor(px),iy=Math.floor(py),iz=Math.floor(pz),fx=px-ix,fy=py-iy,fz=pz-iz;
+  let u=0,m=0;
+  for(let dz=0;dz<2;dz++)for(let dy=0;dy<2;dy++)for(let dx=0;dx<2;dx++){
+    const a=Math.max(0,Math.min(size-1,ix+dx)),b=Math.max(0,Math.min(size-1,iy+dy)),c=Math.max(0,Math.min(size-1,iz+dz));
+    const at=((c*size+b)*size+a)*2,weight=(dx?fx:1-fx)*(dy?fy:1-fy)*(dz?fz:1-fz);
+    if(channel!==1)u+=DataUtils.fromHalfFloat(data[at])*weight;
+    if(channel!==0)m+=DataUtils.fromHalfFloat(data[at+1])*weight;
+  }
+  return channel===0?u:channel===1?m:reconstructedDensity(u,m);
+}
+export const sampleReconstruction=(volume:ReconstructionVolume,x:number,y:number,z:number,channel:0|1)=>interpolate(volume,x,y,z,channel);
+export const sampleReconstructedDensity=(volume:ReconstructionVolume,x:number,y:number,z:number)=>interpolate(volume,x,y,z);
