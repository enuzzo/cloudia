+import {describe,it,expect} from 'vitest';
+import {DataUtils} from 'three/webgpu';
+import {sampleReconstruction,sampleReconstructedDensity,type ReconstructionVolume} from './reconstruction';
+import {bakeOccupancy,densitySupportBounds,sampleDetail,BOUNDS_MIN,BOUNDS_SIZE,type DetailVolume} from './volume';
+import {THERMAL_DISPLACEMENT} from './motion';
+
+const index=(size:number,x:number,y:number,z:number)=>(z*size+y)*size+x;
+const clamp=(value:number)=>Math.max(0,Math.min(1,value));
+function emptyField(size:number,u=-.001):ReconstructionVolume {
+  const data=new Uint16Array(size**3*2);
+  for(let i=0;i<size**3;i++){
+    data[i*2]=DataUtils.toHalfFloat(u);
+    data[i*2+1]=DataUtils.toHalfFloat(1);
+  }
+  return {size,data};
+}
+function support(reconstruction:ReconstructionVolume,coarse:number){
+  const envelope:DetailVolume&{reconstruction:ReconstructionVolume}={size:reconstruction.size,data:new Uint8Array(reconstruction.size**3*4),reconstruction};
+  const detail={size:coarse,data:new Uint8Array(coarse**3*4)};
+  bakeOccupancy(envelope,detail,THERMAL_DISPLACEMENT);
+  return {envelope,detail,bounds:densitySupportBounds(envelope)};
+}
+function expectCovered(coord:readonly number[],detail:DetailVolume,bounds:{min:number[];max:number[]}){
+  const world=coord.map((v,axis)=>BOUNDS_MIN[axis]+v*BOUNDS_SIZE[axis]);
+  // Reference coordinates precede bounded flow and the fine warp. Exercise all
+  // eight signed corners of their combined displacement box, not only its axes.
+  for(let signs=0;signs<8;signs++){
+    const reference=world.map((v,axis)=>v+((signs>>axis)&1?1:-1)*([.08,.06,.08][axis]+THERMAL_DISPLACEMENT[axis]));
+    const uv=reference.map((v,axis)=>(v-BOUNDS_MIN[axis])/BOUNDS_SIZE[axis]);
+    expect(sampleDetail(detail,uv[0],uv[1],uv[2],3,false)).toBeGreaterThan(0);
+    for(let axis=0;axis<3;axis++){
+      expect(reference[axis]).toBeGreaterThanOrEqual(bounds.min[axis]-1e-12);
+      expect(reference[axis]).toBeLessThanOrEqual(bounds.max[axis]+1e-12);
+    }
+  }
+}
+
+describe('post-interpolation reconstruction support',()=>{
+  it('covers positive reconstructed density even when every nodal density proxy is zero',()=>{
+    const size=16,reconstruction=emptyField(size),site=[8,7,8],at=index(size,site[0],site[1],site[2])*2;
+    reconstruction.data[at]=DataUtils.toHalfFloat(.5);
+    reconstruction.data[at+1]=DataUtils.toHalfFloat(0);
+    // The only positive U has M=0; every other node has U<0. Their nodal
+    // clamp(U)*M and R8 proxy are zero, while their separately filtered product is not.
+    for(let i=0;i<size**3;i++)expect(clamp(DataUtils.fromHalfFloat(reconstruction.data[i*2]))*DataUtils.fromHalfFloat(reconstruction.data[i*2+1])).toBe(0);
+    const {envelope,detail,bounds}=support(reconstruction,8);
+    expect(envelope.data.every(value=>value===0)).toBe(true);
+    for(let axis=0;axis<3;axis++)for(const sign of [-1,1]){
+      const coord=site.map((v,a)=>(v+.5+(a===axis?sign*.99:0))/size);
+      expect(sampleReconstructedDensity(reconstruction,coord[0],coord[1],coord[2])).toBeGreaterThan(.002);
+      expectCovered(coord,detail,bounds);
+    }
+  });
+
+  it('retains positive half values below the R8 proxy threshold in every phase',()=>{
+    const size=12,site=[6,5,6],coord=site.map(v=>(v+.5)/size);
+    for(const ice of [0,.25,.5,.75,1])for(const desiredU of [2**-24,.0005,.0015]){
+      const reconstruction=emptyField(size),offset=.025-.017*ice,gain=10+4*ice;
+      const carved=offset+desiredU/gain,at=index(size,site[0],site[1],site[2])*2;
+      reconstruction.data[at]=DataUtils.toHalfFloat((carved-offset)*gain);
+      const u=sampleReconstruction(reconstruction,coord[0],coord[1],coord[2],0);
+      expect(u).toBeGreaterThan(0);expect(Math.round(u*255)).toBe(0);
+      const {detail,bounds}=support(reconstruction,6);
+      expectCovered(coord,detail,bounds);
+    }
+  });
+
+  it('encloses oblique, mixed-phase interfaces after quantized RG interpolation',()=>{
+    const size=12,reconstruction=emptyField(size);
+    for(let z=2;z<size-2;z++)for(let y=2;y<size-2;y++)for(let x=2;x<size-2;x++){
+      const ice=clamp((y-3)/5),carved=.017+.012*(x-5)-.009*(z-5)+.004*(y-5);
+      const at=index(size,x,y,z)*2;
+      reconstruction.data[at]=DataUtils.toHalfFloat((carved-(.025-.017*ice))*(10+4*ice));
+      reconstruction.data[at+1]=DataUtils.toHalfFloat(.3+.02*(x+y+z));
+    }
+    // An uneven macro/mask ratio also exercises the integer bucket mapping.
+    const {detail,bounds}=support(reconstruction,7);let occupied=0,empty=0;
+    for(let z=1;z<size-2;z+=2)for(let y=1;y<size-2;y+=2)for(let x=1;x<size-2;x+=2)for(const fraction of [.2,.8]){
+      const coord=[x,y,z].map((v,axis)=>(v+.5+(axis===1?1-fraction:fraction))/size);
+      const density=sampleReconstructedDensity(reconstruction,coord[0],coord[1],coord[2]);
+      if(density<=0){empty++;continue;}
+      occupied++;expectCovered(coord,detail,bounds);
+    }
+    expect(occupied).toBeGreaterThan(20);expect(empty).toBeGreaterThan(20);
+  });
+
+  it('does not invent support from negative half values or either signed zero',()=>{
+    const size=4,reconstruction=emptyField(size);
+    const nonpositive=[-.1,-(2**-24),-(2**-30),-0,0];
+    for(let i=0;i<size**3;i++)reconstruction.data[i*2]=DataUtils.toHalfFloat(nonpositive[i%nonpositive.length]);
+    const {detail}=support(reconstruction,4);
+    for(let i=3;i<detail.data.length;i+=4)expect(detail.data[i]).toBe(0);
+    for(const coord of [[.5,.5,.5],[.12,.37,.91],[-1,1,2]])expect(sampleReconstructedDensity(reconstruction,coord[0],coord[1],coord[2])).toBe(0);
+  });
+});
