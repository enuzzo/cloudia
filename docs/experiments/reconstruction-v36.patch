+import {describe,expect,it} from 'vitest';
+import {DataUtils} from 'three/webgpu';
+import {reconstructedDensity,sampleReconstruction,sampleReconstructedDensity,type ReconstructionVolume} from './reconstruction';
+
+const packed=(size:number,value:(x:number,y:number,z:number)=>[number,number]):ReconstructionVolume=>{
+  const data=new Uint16Array(size**3*2);
+  for(let z=0;z<size;z++)for(let y=0;y<size;y++)for(let x=0;x<size;x++){
+    const at=((z*size+y)*size+x)*2,[u,m]=value(x,y,z);
+    data[at]=DataUtils.toHalfFloat(u);data[at+1]=DataUtils.toHalfFloat(m);
+  }
+  return {size,data};
+};
+describe('condensation reconstruction after half-float interpolation',()=>{
+  it('reconstructs an affine unclamped field independently of its grid phase',()=>{
+    const size=8,gain=10,spacing=.125;
+    for(const offset of [0,.25,.5,.75]){
+      const midpoint=.5+offset*spacing,volume=packed(size,x=>[(x+.5)/size*gain-midpoint*gain+.5,.75]);
+      for(const delta of [-.045,-.02,0,.02,.045]){
+        const x=midpoint+delta;
+        expect(sampleReconstruction(volume,x,.5,.5,0)).toBeCloseTo(.5+gain*delta,10);
+        expect(sampleReconstructedDensity(volume,x,.5,.5)).toBeCloseTo((.5+gain*delta)*.75,10);
+      }
+    }
+  });
+  it('clamps condensation after interpolation rather than interpolating a pre-clamped ramp',()=>{
+    const volume=packed(2,x=>[x?2:-1,1]);
+    expect(sampleReconstructedDensity(volume,.5,.5,.5)).toBe(.5);
+    expect(sampleReconstructedDensity(volume,.4,.5,.5)).toBeCloseTo(0,12);
+    expect(sampleReconstructedDensity(volume,.6,.5,.5)).toBe(1);
+  });
+  it('interpolates original modulation separately, including zero-condensation nodes',()=>{
+    const volume=packed(2,x=>x?[2,0]:[-1,1]);
+    // Every nodal C(U)*M is zero, while the two interpolated fields overlap.
+    expect(reconstructedDensity(-1,1)).toBe(0);
+    expect(reconstructedDensity(2,0)).toBe(0);
+    expect(sampleReconstructedDensity(volume,.5,.5,.5)).toBe(.25);
+  });
+  it('uses texel centres, clamps boundaries and decodes the stored half values',()=>{
+    const volume=packed(2,(x,y,z)=>[x+2*y+4*z-.3,.65+.05*x+.1*y+.2*z]);
+    for(let z=0;z<2;z++)for(let y=0;y<2;y++)for(let x=0;x<2;x++){
+      const at=((z*2+y)*2+x)*2;
+      expect(sampleReconstruction(volume,(x+.5)/2,(y+.5)/2,(z+.5)/2,0)).toBe(DataUtils.fromHalfFloat(volume.data[at]));
+      expect(sampleReconstruction(volume,(x+.5)/2,(y+.5)/2,(z+.5)/2,1)).toBe(DataUtils.fromHalfFloat(volume.data[at+1]));
+    }
+    expect(sampleReconstruction(volume,-2,-1,0,0)).toBe(DataUtils.fromHalfFloat(volume.data[0]));
+    expect(sampleReconstruction(volume,2,1,8,1)).toBe(DataUtils.fromHalfFloat(volume.data[15]));
+  });
+  it('cannot create positive condensation when every stencil coordinate is nonpositive',()=>{
+    const volume=packed(2,(x,y,z)=>[-.1*(x+y+z),1]);
+    for(let i=0;i<=100;i++)expect(sampleReconstructedDensity(volume,i/100,.73,.16)).toBe(0);
+  });
+});
