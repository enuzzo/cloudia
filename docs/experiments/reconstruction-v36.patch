+
+/** Pop every scope before awaiting, so another renderer task cannot interleave
+ * its scopes with ours. No ownership of the caller's device is taken here. */
+async function checkedGPU<T>(device:GPUDevice,operation:()=>T|Promise<T>):Promise<T>{
+  device.pushErrorScope('out-of-memory');device.pushErrorScope('internal');device.pushErrorScope('validation');
+  let work:Promise<T>;
+  try{work=Promise.resolve(operation());}catch(error){work=Promise.reject(error);}
+  const scopes=Promise.all([device.popErrorScope(),device.popErrorScope(),device.popErrorScope()]);
+  const [result,captured]=await Promise.allSettled([work,scopes]);
+  if(result.status==='rejected')throw result.reason;
+  if(captured.status==='rejected')throw captured.reason;
+  const errors=captured.value.filter((error):error is GPUError=>error!==null);
+  if(errors.length)throw new Error(`Reconstruction audit GPU error: ${errors.map(error=>error.message).join('; ')}`);
+  return result.value;
+}
+
+const AUDIT_WGSL=`
+@group(0) @binding(0) var reconstructionField:texture_3d<f32>;
+@group(0) @binding(1) var linearClampSampler:sampler;
+@group(0) @binding(2) var<storage,read> queries:array<vec4<f32>>;
+@group(0) @binding(3) var<storage,read_write> observations:array<vec4<f32>>;
+@compute @workgroup_size(${WORKGROUP_SIZE})
+fn main(@builtin(global_invocation_id) id:vec3<u32>){
+  if(id.x>=${QUERY_COUNT}u){return;}
+  let pair=textureSampleLevel(reconstructionField,linearClampSampler,queries[id.x].xyz,0.0).rg;
+  observations[id.x]=vec4<f32>(pair,clamp(pair.x,0.0,1.0)*pair.y,0.0);
+}`;
+
+function summarize(volume:ReconstructionVolume,selection:ReturnType<typeof auditQueries>,gpuValues:Float32Array):ReconstructionSamplingAudit{
+  // Advisory thresholds chosen for inspection, not promised WebGPU bounds.
+  const absolute=2e-3,relative=2e-3;
+  const errors=Object.fromEntries(CHANNELS.map(channel=>[channel,{finitePairs:0,cpuNonFinite:0,gpuNonFinite:0,
+    maxAbsoluteError:null,rmsAbsoluteError:null,worstQueryIndex:null,outsideAdvisoryTolerance:0}])) as Record<Channel,ChannelError>;
+  const squared:Record<Channel,number>={U:0,M:0,rho:0};
+  const byKind:Record<QueryKind,number>={'texel-center':0,fractional:0,'edge-clamp':0,volume:0,'mixed-U':0,'mixed-U-unavailable':0};
+  let minU=Infinity,maxU=-Infinity,inBand=0,below=0,between=0,above=0,paddingAllZero=true;
+  const json=(value:number)=>Number.isFinite(value)?value:null;
+  const samples=selection.queries.map((query,index)=>{
+    byKind[query.kind]++;
+    const [x,y,z]=query.uvw,u=sampleReconstruction(volume,x,y,z,0),m=sampleReconstruction(volume,x,y,z,1);
+    const cpu:Vec3=[u,m,reconstructedDensity(u,m)],gpu:Vec3=[gpuValues[index*4],gpuValues[index*4+1],gpuValues[index*4+2]];
+    paddingAllZero&&=gpuValues[index*4+3]===0;
+    if(Number.isFinite(u)){minU=Math.min(minU,u);maxU=Math.max(maxU,u);if(u>=-1&&u<=2)inBand++;if(u<0)below++;else if(u<=1)between++;else above++;}
+    const difference=CHANNELS.map((channel,c)=>{
+      const stats=errors[channel],cpuFinite=Number.isFinite(cpu[c]),gpuFinite=Number.isFinite(gpu[c]);
+      if(!cpuFinite)stats.cpuNonFinite++;if(!gpuFinite)stats.gpuNonFinite++;
+      if(!cpuFinite||!gpuFinite)return null;
+      const error=Math.abs(cpu[c]-gpu[c]);stats.finitePairs++;squared[channel]+=error*error;
+      if(stats.maxAbsoluteError===null||error>stats.maxAbsoluteError){stats.maxAbsoluteError=error;stats.worstQueryIndex=index;}
+      if(error>absolute+relative*Math.abs(cpu[c]))stats.outsideAdvisoryTolerance++;
+      return error;
+    }) as JsonVec3;
+    return {index,kind:query.kind,uvw:query.uvw,cpu:cpu.map(json) as JsonVec3,gpu:gpu.map(json) as JsonVec3,absoluteError:difference};
+  });
+  for(const channel of CHANNELS){const stats=errors[channel];stats.rmsAbsoluteError=stats.finitePairs?Math.sqrt(squared[channel]/stats.finitePairs):null;}
+  const allFinite=gpuValues.every(Number.isFinite)&&CHANNELS.every(channel=>errors[channel].cpuNonFinite===0&&errors[channel].gpuNonFinite===0);
+  return {
+    method:'Raw GPU sampler diagnostic only: temporary texture uploaded from the identical half-float payload; 512 deterministic float32 coordinates; RG16F linear/clamp samples followed by clamp(U,0,1)*M. Not a cloud render, navigation proof, photographic acceptance or benchmark.',
+    queryCount:QUERY_COUNT,texture:{format:'rg16float',size:volume.size,payloadBytes:volume.data.byteLength},
+    coordinatePrecision:'Identical float32 UVW on CPU and GPU; storage input/output stride 16 bytes (vec4<f32>), output w=0.',
+    referencePrecision:'CPU reference decodes the same half payload and uses ideal binary64 trilinear weights/arithmetic at float32 coordinates. GPU sampling precision and f32 arithmetic may differ; bitwise identity is not assumed. Non-finite values are encoded as null and counted per channel.',
+    sampler:'3D normalized coordinates, linear min/mag filtering, clamp-to-edge U/V/W, mip level 0, one mip.',
+    advisoryTolerance:{absolute,relative,rule:'abs(GPU-CPU) <= absolute + relative*abs(CPU)',qualification:'Inspection aid only; not a universal texture-precision guarantee or automatic material acceptance.'},
+    allFinite,withinAdvisoryTolerance:allFinite&&paddingAllZero&&CHANNELS.every(channel=>errors[channel].outsideAdvisoryTolerance===0),
+    gpuPaddingAllZero:paddingAllZero,errors,
+    coverage:{byKind,searchedPairs:selection.searchedPairs,mixedPairsFound:selection.mixedPairsFound,
+      referenceURange:Number.isFinite(minU)?[minU,maxU]:null,referenceUWithinMinus1To2:inBand,
+      referenceUBelowZero:below,referenceUBetweenZeroAndOne:between,referenceUAboveOne:above},samples,
+  };
+}
+
+/** Explicit diagnostic activation only. Caller keeps the source immutable and
+ * waits for this promise before destroying the supplied device. All temporary
+ * buffers/textures are released here; samplers/pipelines have no destroy API. */
+export async function auditReconstructionSampling(device:GPUDevice,reconstruction:ReconstructionVolume):Promise<ReconstructionSamplingAudit>{
+  const {size,data}=reconstruction;
+  if(!Number.isSafeInteger(size)||size<1||size>device.limits.maxTextureDimension3D||
+    !(data instanceof Uint16Array)||data.length!==size**3*2)throw new Error('Invalid RG16F reconstruction volume for sampler audit.');
+  const sourceBuffer=data.buffer;
+  if(!(sourceBuffer instanceof ArrayBuffer))throw new Error('Sampler audit requires an ArrayBuffer half-float payload.');
+  const payload=new Uint8Array(sourceBuffer,data.byteOffset,data.byteLength);
+  const selection=auditQueries(reconstruction),queryData=new Float32Array(QUERY_COUNT*4);
+  selection.queries.forEach((query,index)=>queryData.set(query.uvw,index*4));
+  let texture:GPUTexture|null=null,input:GPUBuffer|null=null,output:GPUBuffer|null=null,readback:GPUBuffer|null=null;
+  try{
+    const module=await checkedGPU(device,()=>{
+      texture=device.createTexture({label:'reconstruction audit RG16F',dimension:'3d',size:{width:size,height:size,depthOrArrayLayers:size},
+        format:'rg16float',mipLevelCount:1,usage:GPUTextureUsage.TEXTURE_BINDING|GPUTextureUsage.COPY_DST});
+      input=device.createBuffer({label:'reconstruction audit queries',size:queryData.byteLength,usage:GPUBufferUsage.STORAGE|GPUBufferUsage.COPY_DST});
+      output=device.createBuffer({label:'reconstruction audit observations',size:queryData.byteLength,usage:GPUBufferUsage.STORAGE|GPUBufferUsage.COPY_SRC});
+      readback=device.createBuffer({label:'reconstruction audit readback',size:queryData.byteLength,usage:GPUBufferUsage.MAP_READ|GPUBufferUsage.COPY_DST});
+      return device.createShaderModule({label:'reconstruction sampler audit',code:AUDIT_WGSL});
+    });
+    const compilation=await module.getCompilationInfo(),failures=compilation.messages.filter(message=>message.type==='error');
+    if(failures.length)throw new Error(`Reconstruction audit WGSL: ${failures.map(message=>`${message.lineNum}:${message.linePos} ${message.message}`).join('; ')}`);
+    const pipeline=await checkedGPU(device,()=>device.createComputePipelineAsync({label:'reconstruction sampler audit',layout:'auto',compute:{module,entryPoint:'main'}}));
+    // Assignments inside the allocation callback are intentionally tracked above
+    // so partial allocation failure still reaches the same finally cleanup.
+    const field=texture as GPUTexture|null,queries=input as GPUBuffer|null,result=output as GPUBuffer|null,download=readback as GPUBuffer|null;
+    if(!field||!queries||!result||!download)throw new Error('Incomplete reconstruction audit GPU allocation.');
+    await checkedGPU(device,()=>{
+      const sampler=device.createSampler({label:'reconstruction audit linear clamp',addressModeU:'clamp-to-edge',addressModeV:'clamp-to-edge',addressModeW:'clamp-to-edge',minFilter:'linear',magFilter:'linear',mipmapFilter:'nearest'});
+      const bindGroup=device.createBindGroup({layout:pipeline.getBindGroupLayout(0),entries:[
+        {binding:0,resource:field.createView({dimension:'3d'})},{binding:1,resource:sampler},
+        {binding:2,resource:{buffer:queries}},{binding:3,resource:{buffer:result}},
+      ]});
+      // writeTexture accepts tightly packed rows; unlike buffer-to-texture
+      // commands it does not require a 256-byte row stride. Preserve half bits.
+      device.queue.writeTexture({texture:field},payload,{bytesPerRow:size*4,rowsPerImage:size},{width:size,height:size,depthOrArrayLayers:size});
+      device.queue.writeBuffer(queries,0,queryData);
+      const encoder=device.createCommandEncoder({label:'reconstruction audit commands'}),pass=encoder.beginComputePass();
+      pass.setPipeline(pipeline);pass.setBindGroup(0,bindGroup);pass.dispatchWorkgroups(Math.ceil(QUERY_COUNT/WORKGROUP_SIZE));pass.end();
+      encoder.copyBufferToBuffer(result,0,download,0,queryData.byteLength);device.queue.submit([encoder.finish()]);
+    });
+    await download.mapAsync(GPUMapMode.READ);
+    const values=new Float32Array(download.getMappedRange().slice(0));
+    download.unmap();
+    return summarize(reconstruction,selection,values);
+  }catch(error){
+    throw new Error(`Reconstruction sampler audit failed: ${error instanceof Error?error.message:String(error)}`,{cause:error});
+  }finally{
+    const download=readback as GPUBuffer|null;
+    if(download?.mapState==='mapped')download.unmap();
+    for(const buffer of [input,output,readback] as Array<GPUBuffer|null>)buffer?.destroy();
+    (texture as GPUTexture|null)?.destroy();
+  }
+}
