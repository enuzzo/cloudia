@@ -0,0 +1,201 @@
+import {DataUtils} from 'three/webgpu';
+import {sampleReconstruction,reconstructedDensity,type ReconstructionVolume} from './reconstruction';
+
+const QUERY_COUNT=512,WORKGROUP_SIZE=64,PAIR_SEARCH_LIMIT=65536;
+const CHANNELS=['U','M','rho'] as const;
+type Channel=typeof CHANNELS[number];
+type QueryKind='texel-center'|'fractional'|'edge-clamp'|'volume'|'mixed-U'|'mixed-U-unavailable';
+type Vec3=[number,number,number];
+type JsonVec3=[number|null,number|null,number|null];
+interface Query {kind:QueryKind;uvw:Vec3}
+interface ChannelError {
+  finitePairs:number;cpuNonFinite:number;gpuNonFinite:number;
+  maxAbsoluteError:number|null;rmsAbsoluteError:number|null;
+  worstQueryIndex:number|null;outsideAdvisoryTolerance:number;
+}
+export interface ReconstructionSamplingAudit {
+  method:string;queryCount:number;texture:{format:'rg16float';size:number;payloadBytes:number};
+  coordinatePrecision:string;referencePrecision:string;sampler:string;
+  advisoryTolerance:{absolute:number;relative:number;rule:string;qualification:string};
+  allFinite:boolean;withinAdvisoryTolerance:boolean;gpuPaddingAllZero:boolean;
+  errors:Record<Channel,ChannelError>;
+  coverage:{byKind:Record<QueryKind,number>;searchedPairs:number;mixedPairsFound:number;
+    referenceURange:[number,number]|null;referenceUWithinMinus1To2:number;
+    referenceUBelowZero:number;referenceUBetweenZeroAndOne:number;referenceUAboveOne:number};
+  samples:Array<{index:number;kind:QueryKind;uvw:Vec3;cpu:JsonVec3;gpu:JsonVec3;absoluteError:JsonVec3}>;
+}
+
+function radicalInverse(value:number,base:number){
+  let result=0,weight=1/base;
+  while(value>0){result+=(value%base)*weight;value=Math.floor(value/base);weight/=base;}
+  return result;
+}
+
+/** Bounded search of adjacent texels, not another volume generation or full scan. */
+function auditQueries(volume:ReconstructionVolume){
+  const {size,data}=volume,queries:Query[]=[];
+  const add=(kind:QueryKind,uvw:Vec3)=>queries.push({kind,uvw:uvw.map(Math.fround) as Vec3});
+  const anchors:Vec3[]=[];
+  for(let z=0;z<4;z++)for(let y=0;y<4;y++)for(let x=0;x<4;x++){
+    const center=[x,y,z].map(v=>(Math.min(size-1,Math.floor((v+.5)*size/4))+.5)/size) as Vec3;
+    anchors.push(center);add('texel-center',center);
+  }
+  for(const center of anchors)add('fractional',[center[0]+.375/size,center[1]-.125/size,center[2]+.25/size]);
+  const edges=[-1/size,0,1,1+1/size];
+  for(const z of edges)for(const y of edges)for(const x of edges)add('edge-clamp',[x,y,z]);
+  for(let i=1;i<=128;i++)add('volume',[radicalInverse(i,2),radicalInverse(i,3),radicalInverse(i,5)]);
+
+  let searchedPairs=0,mixedPairsFound=0;
+  const voxelCount=size**3,searchCount=Math.min(PAIR_SEARCH_LIMIT,voxelCount),strides=[1,size,size*size];
+  // Different odd increments distribute this bounded probe through all axes.
+  for(let i=0;i<searchCount&&mixedPairsFound<48;i++){
+    searchedPairs++;
+    const index=(Math.imul(i+1,0x9e3779b1)>>>0)%voxelCount,axis=i%3;
+    const xyz=[index%size,Math.floor(index/size)%size,Math.floor(index/(size*size))];
+    if(xyz[axis]===size-1)continue;
+    const next=index+strides[axis],a=DataUtils.fromHalfFloat(data[index*2]),b=DataUtils.fromHalfFloat(data[next*2]);
+    const ma=DataUtils.fromHalfFloat(data[index*2+1]),mb=DataUtils.fromHalfFloat(data[next*2+1]);
+    if(![a,b,ma,mb].every(Number.isFinite)||Math.max(ma,mb)<=0||a===b)continue;
+    const lo=Math.min(a,b),hi=Math.max(a,b);
+    if(!((lo<0&&hi>0)||(lo<1&&hi>1)))continue;
+    mixedPairsFound++;
+    const bandMin=Math.max(-1,lo),bandMax=Math.min(2,hi);
+    for(const quantile of [.125,.375,.625,.875]){
+      const target=bandMin+(bandMax-bandMin)*quantile,fraction=(target-a)/(b-a);
+      const uvw=xyz.map(v=>(v+.5)/size) as Vec3;uvw[axis]+=fraction/size;
+      add('mixed-U',uvw);
+    }
+  }
+  while(queries.length<QUERY_COUNT){
+    const i=queries.length+1;
+    add('mixed-U-unavailable',[radicalInverse(i,2),radicalInverse(i,3),radicalInverse(i,5)]);
+  }
+  return {queries,searchedPairs,mixedPairsFound};
