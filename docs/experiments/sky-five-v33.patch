new file mode 100644
index 0000000..5af0290
--- /dev/null
+++ b/src/cumulonimbus/skyVisibility.ts
@@ -0,0 +1,45 @@
+import {bakeOpticalDepth} from './light';
+
+// Four oblique upper-hemisphere directions. Normalization is handled by the
+// optical-depth bake; their unit vectors have y=1/3 and horizontal length sqrt(8)/3.
+const horizontal=Math.sqrt(8);
+export const SKY_VISIBILITY_DIRECTIONS=[
+  [horizontal,1,0],[-horizontal,1,0],[0,1,horizontal],[0,1,-horizontal],
+] as const;
+export const SKY_VISIBILITY_VERTICAL_WEIGHT=1/4;
+export const SKY_VISIBILITY_LATERAL_WEIGHT=3/16;
+export const SKY_VISIBILITY_TAU_MAX=16;
+// Preserve the existing vertical ambient response for an equal-depth sky.
+export const SKY_VISIBILITY_SOFTENING=.35;
+
+/** Add four static optical depths from the same extinction-weighted density
+ * used by the existing solar/vertical caches. Pack one sweep at a time; do not
+ * retain four full Float32 depth volumes. Channel order follows the directions.
+ */
+export function bakeSkyVisibilityTau(density:Float32Array,size:number,dimensions:readonly number[],extinction:number,progress?:(fraction:number)=>void):Uint8Array {
+  const packed=new Uint8Array(density.length*4);
+  for(let channel=0;channel<SKY_VISIBILITY_DIRECTIONS.length;channel++){
+    const tau=bakeOpticalDepth(density,size,dimensions,SKY_VISIBILITY_DIRECTIONS[channel],extinction);
+    for(let i=0;i<density.length;i++)packed[i*4+channel]=Math.round(Math.max(0,Math.min(1,tau[i]/SKY_VISIBILITY_TAU_MAX))*255);
+    progress?.((channel+1)/SKY_VISIBILITY_DIRECTIONS.length);
+  }
+  return packed;
+}
+
+/** Decoded depths, not normalized texture bytes. Scale each depth by current
+ * mass before averaging its response: a pre-averaged visibility cannot later
+ * recover the response to dispersion. The .35 softening is the existing model.
+ */
+export function skyVisibility(tauVertical:number,tauLateral:ArrayLike<number>,massFactor:number):number {
+  const scale=-SKY_VISIBILITY_SOFTENING*massFactor;
+  let visibility=SKY_VISIBILITY_VERTICAL_WEIGHT*Math.exp(scale*tauVertical);
+  for(let channel=0;channel<4;channel++)visibility+=SKY_VISIBILITY_LATERAL_WEIGHT*Math.exp(scale*tauLateral[channel]);
+  return visibility;
+}
+
+export const SKY_VISIBILITY_WGSL=`
+fn cloudSkyVisibility(tauVertical:f32,tauLateral:vec4<f32>,massFactor:f32)->f32{
+  let scale=-${SKY_VISIBILITY_SOFTENING}*massFactor;
+  let lateral=exp(tauLateral*scale);
+  return ${SKY_VISIBILITY_VERTICAL_WEIGHT}*exp(tauVertical*scale)+${SKY_VISIBILITY_LATERAL_WEIGHT}*dot(lateral,vec4<f32>(1.0));
+}`;
