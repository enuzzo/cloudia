+import {describe,it,expect} from 'vitest';
+import {bakeSkyVisibilityTau,skyVisibility,SKY_VISIBILITY_DIRECTIONS,SKY_VISIBILITY_VERTICAL_WEIGHT,SKY_VISIBILITY_LATERAL_WEIGHT,SKY_VISIBILITY_TAU_MAX,SKY_VISIBILITY_SOFTENING} from './skyVisibility';
+
+const index=(size:number,x:number,y:number,z:number)=>(z*size+y)*size+x;
+
+describe('directional sky visibility',()=>{
+  it('integrates constant, first and second hemisphere moments without a surface cosine',()=>{
+    const samples=[{direction:[0,1,0],weight:SKY_VISIBILITY_VERTICAL_WEIGHT},...SKY_VISIBILITY_DIRECTIONS.map(d=>({direction:d.map(v=>v/Math.hypot(...d)),weight:SKY_VISIBILITY_LATERAL_WEIGHT}))];
+    const moment=(a:number,b?:number)=>samples.reduce((sum,s)=>sum+s.weight*s.direction[a]*(b===undefined?1:s.direction[b]),0);
+    expect(samples.reduce((sum,s)=>sum+s.weight,0)).toBe(1);
+    expect(moment(0)).toBeCloseTo(0,14);expect(moment(2)).toBeCloseTo(0,14);
+    expect(moment(1)).toBeCloseTo(.5,14);
+    for(let axis=0;axis<3;axis++)expect(moment(axis,axis)).toBeCloseTo(1/3,14);
+    for(const [a,b] of [[0,1],[0,2],[1,2]])expect(moment(a,b)).toBeCloseTo(0,14);
+  });
+
+  it('reduces to the existing response when all five optical depths agree',()=>{
+    for(const tau of [0,.5,3,16])for(const mass of [0,.1,.37,1]){
+      expect(skyVisibility(tau,[tau,tau,tau,tau],mass)).toBeCloseTo(Math.exp(-SKY_VISIBILITY_SOFTENING*mass*tau),14);
+    }
+  });
+
+  it('distinguishes lateral openings at unchanged vertical and mean optical depth',()=>{
+    // Both configurations have weighted mean tau=4. Averages of depth would
+    // erase this opening; an average of attenuated directional responses does not.
+    const closed=skyVisibility(4,[4,4,4,4],1),open=skyVisibility(4,[0,0,8,8],1);
+    expect(open).toBeGreaterThan(closed+.15);
+    expect(open).toBeLessThan(1);
+  });
+
+  it('recombines directional depths before averaging when mass changes',()=>{
+    const depths=[0,0,16,16],unit=skyVisibility(4,depths,1),dispersed=skyVisibility(4,depths,.25);
+    const expected=.25*Math.exp(-.35*.25*4)+.375+.375*Math.exp(-.35*.25*16);
+    expect(dispersed).toBeCloseTo(expected,14);
+    expect(Math.pow(unit,.25)-dispersed).toBeGreaterThan(.1);
+    expect(dispersed).toBeGreaterThan(unit);
+    expect(skyVisibility(4,depths,0)).toBe(1);
+  });
+
+  it('packs homogeneous finite paths in the signed channel order within half a quantization step',()=>{
+    const size=16,dimensions=[16,16,16],density=new Float32Array(size**3).fill(.1),before=density.slice();
+    const progress:number[]=[],packed=bakeSkyVisibilityTau(density,size,dimensions,1,p=>progress.push(p));
+    expect(packed.length).toBe(size**3*4);expect(progress).toEqual([.25,.5,.75,1]);expect(density).toEqual(before);
+    for(let channel=0;channel<4;channel++){
+      const d=SKY_VISIBILITY_DIRECTIONS[channel],axis=d[0]?0:2,remaining=d[axis]>0?size-8-.5:8+.5;
+      const expected=remaining*Math.hypot(...d)/Math.abs(d[axis])*.1;
+      const decoded=packed[index(size,8,8,8)*4+channel]/255*SKY_VISIBILITY_TAU_MAX;
+      expect(Math.abs(decoded-expected)).toBeLessThanOrEqual(SKY_VISIBILITY_TAU_MAX/255/2+1e-6);
+    }
+  });
+
+  it('records one lateral blocker without closing the three unobstructed directions',()=>{
+    const size=16,density=new Float32Array(size**3);
+    for(let z=0;z<size;z++)for(let y=0;y<size;y++)density[index(size,11,y,z)]=.2;
+    const packed=bakeSkyVisibilityTau(density,size,[16,16,16],1),at=index(size,8,8,8)*4;
+    expect(packed[at]).toBeGreaterThan(0);
+    expect(Array.from(packed.slice(at+1,at+4))).toEqual([0,0,0]);
+    const empty=bakeSkyVisibilityTau(new Float32Array(8),2,[2,2,2],18);
+    expect(empty.every(value=>value===0)).toBe(true);
+  });
+});
